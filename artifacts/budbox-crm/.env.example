# Local UI toggle only. Not an authorization mechanism; replace with authenticated roles.
VITE_CRM_ADMIN=false

# Demo fixtures are disabled unless explicitly enabled for local UI development.
VITE_USE_MOCKS=false

# Public backend origin for production. Leave empty for same-origin /api requests.
VITE_API_BASE_URL=

# Public Supabase project settings used by the sign-in page.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable Email auth and Google OAuth in Supabase; allow this app's origin as a redirect URL.
